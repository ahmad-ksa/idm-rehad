{
  "manifest_version": 3,
  "name": "Rehad Download Manager",
  "short_name": "Rehad",
  "description": "__MSG_desc__",
  "version": "1.0.0",
  "default_locale": "en",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Rehad", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [ { "js": ["content.js"], "matches": ["http://*/*", "https://*/*"], "all_frames": false, "run_at": "document_idle" } ],
  "permissions": [ "downloads", "nativeMessaging", "cookies", "contextMenus", "webRequest", "webNavigation", "tabs", "storage", "scripting" ],
  "host_permissions": [ "<all_urls>" ],
  "minimum_chrome_version": "109"
}
